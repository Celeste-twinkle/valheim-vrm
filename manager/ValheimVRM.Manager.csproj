<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net471</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <Version>2.0.7</Version>
    <AssemblyTitle>Valheim VRM Manager</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Windows.Forms" />
    <EmbeddedResource Include="../LICENSE" LogicalName="License.ValheimVRM.txt" />
    <EmbeddedResource Include="licenses/*.txt" LogicalName="License.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(ManagerClientZip)" LogicalName="Payload.Client.zip" Condition="'$(ManagerClientZip)' != ''" />
    <EmbeddedResource Include="$(ManagerServerZip)" LogicalName="Payload.Server.zip" Condition="'$(ManagerServerZip)' != ''" />
    <EmbeddedResource Include="$(ManagerLoaderZip)" LogicalName="Payload.Loader.zip" Condition="'$(ManagerLoaderZip)' != ''" />
  </ItemGroup>
</Project>
