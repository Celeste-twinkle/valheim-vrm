<Window x:Class="ValheimVRM.Manager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Valheim VRM 管理器" Width="758" Height="592" MinWidth="625" MinHeight="535"
    WindowStartupLocation="CenterScreen" Language="zh-CN"
    FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
    Background="#F3F5F2" Foreground="#1B2823" UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Display"
    AllowDrop="True" PreviewDragOver="FilesDragged" PreviewDrop="FilesDropped" DragLeave="FilesLeft"
    Loaded="WindowLoaded" Closing="WindowClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#506259" />
        <SolidColorBrush x:Key="Line" Color="#D5DDD7" />
        <SolidColorBrush x:Key="Accent" Color="#225B49" />
        <SolidColorBrush x:Key="AccentTint" Color="#E5EFE9" />
        <SolidColorBrush x:Key="Error" Color="#9D3229" />
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Foreground" Value="#24382F" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Body" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style x:Key="TargetTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Body" Background="Transparent" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#EDF3EE" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{StaticResource AccentTint}" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,17,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Panel}" HorizontalAlignment="Left" Padding="3" Margin="0,0,0,13">
            <StackPanel x:Name="TargetTabs" Orientation="Horizontal">
                <RadioButton x:Name="ClientTab" Style="{StaticResource TargetTab}" GroupName="Target"
                             Content="客户端" IsChecked="True" Checked="TargetChanged" />
                <RadioButton x:Name="DedicatedTab" Style="{StaticResource TargetTab}" GroupName="Target"
                             Content="专用服务器" Checked="TargetChanged" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="安装目录" Style="{StaticResource SectionHeading}" Margin="0,0,0,6" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Panel}" CornerRadius="5">
                    <TextBox x:Name="InstallPath" Height="32" BorderThickness="0" Padding="9,0"
                             Background="Transparent" VerticalContentAlignment="Center"
                             AutomationProperties.Name="安装目录" TextChanged="PathEdited" KeyDown="PathKeyDown"
                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </Border>
                <Button x:Name="BrowseButton" Grid.Column="1" Margin="7,0,0,0" Content="浏览" Click="BrowsePath" />
                <Button x:Name="DetectButton" Grid.Column="2" Margin="7,0,0,0" Content="自动检测" Click="DetectPath" />
            </Grid>
            <TextBlock x:Name="PathHint" Grid.Row="2" Margin="1,5,0,0" Style="{StaticResource Caption}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,0,0,13">
            <StackPanel>
                <DockPanel Margin="13,9,13,7" LastChildFill="False">
                    <TextBlock Text="模组" Style="{StaticResource SectionHeading}" />
                    <TextBlock x:Name="LoaderStatus" DockPanel.Dock="Right"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </DockPanel>
                <Border x:Name="ClientComponent" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="13,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,9,0">
                            <TextBlock Text="客户端模组" FontWeight="SemiBold" />
                            <TextBlock x:Name="ClientStatus" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ClientInstall" Style="{StaticResource Primary}" Content="安装"
                                    AutomationProperties.Name="安装客户端模组" Click="InstallClient" IsEnabled="False" />
                            <Button x:Name="ClientUninstall" Margin="6,0,0,0" Content="卸载" Visibility="Collapsed"
                                    AutomationProperties.Name="卸载客户端模组" Click="UninstallClient" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="13,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,9,0">
                            <TextBlock Text="联机同步服务端" FontWeight="SemiBold" />
                            <TextBlock x:Name="ServerStatus" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ServerInstall" Style="{StaticResource Primary}" Content="安装"
                                    AutomationProperties.Name="安装联机同步服务端" Click="InstallServer" IsEnabled="False" />
                            <Button x:Name="ServerUninstall" Margin="6,0,0,0" Content="卸载" Visibility="Collapsed"
                                    AutomationProperties.Name="卸载联机同步服务端" Click="UninstallServer" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Border x:Name="ModelsPanel" Grid.Row="3" Style="{StaticResource Panel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="13,9,13,8" LastChildFill="False">
                    <TextBlock Text="VRM 模型" Style="{StaticResource SectionHeading}" />
                    <TextBlock x:Name="ModelCount" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" />
                </DockPanel>
                <Border x:Name="DropArea" Grid.Row="1" Margin="10,0,10,7" Padding="8,5"
                        BorderThickness="1" BorderBrush="{StaticResource Line}" CornerRadius="5" Background="#F3F7F3">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="AddModel" DockPanel.Dock="Right" Content="添加模型" Click="PickModels"
                                IsEnabled="False" />
                        <TextBlock Style="{StaticResource Caption}" Text="拖放 .vrm 文件"
                                   VerticalAlignment="Center" Margin="3,0,0,0" />
                    </DockPanel>
                </Border>
                <ListBox x:Name="ModelList" Grid.Row="2" Margin="0,0,0,4" BorderThickness="0"
                         Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="已安装的 VRM 模型">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="13,3,10,3" MinHeight="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"
                                           Foreground="{StaticResource Muted}" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="9,0,12,0" />
                                <Button Grid.Column="3" Height="26" MinWidth="48" Padding="8,0"
                                        Content="删除" AutomationProperties.HelpText="{Binding Name}" Click="DeleteModel" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="ModelEmpty" Grid.Row="2" Style="{StaticResource Caption}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Text="暂无模型" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="1,7,1,0" MinHeight="18" Style="{StaticResource Caption}"
                   TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Grid>
</Window>
